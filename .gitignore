local.properties
keystore.properties
*.jks
*.keystore

# IntelliJ IDEA / Android Studio (regenerated by the IDE, not needed to build)
*.iml
.idea/

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log

# Claude Code (personal tooling — keep out of upstream)
.claude/
CLAUDE.md
CLAUDE.local.md
