# Gradle
.gradle/
build/
# ...but keep the wrapper jar so `./gradlew` works right after cloning
!gradle/wrapper/gradle-wrapper.jar

# Android build outputs
/captures
*.apk
*.aab
*.aar
*.ap_
*.dex
*.class

# Native build (NDK)
.externalNativeBuild
.cxx

