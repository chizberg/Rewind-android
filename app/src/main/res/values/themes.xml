<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Rewind" parent="android:Theme.Material.Light.NoActionBar">
        <!-- What the window itself is filled with, i.e. what shows until the first composed frame
             arrives, and what a hole-punched SurfaceView reveals if its surface is not up yet.
             Nothing else reaches it: the gaps the pressed-in map leaves during an overlay
             transition are painted in the app's own background colour by OverlayHost, BELOW the
             map. Below, and never above — an opaque Compose background over a hole-punched
             SurfaceView seals the punch and blacks out the whole composite. -->
        <item name="android:windowBackground">@android:color/black</item>

        <!-- Edge-to-edge in EVERY orientation. The default cutout mode only lets a window into the
             cutout on the screen's short edge, so in landscape the system letterboxes the camera
             strip black and the app starts after it — a stray band down one side that no layout of
             ours could remove. `always` hands us that strip; what must stay clear of it is handled
             by the safe-area insets, per view. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
